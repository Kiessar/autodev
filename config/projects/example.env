# Copy this file to config/projects/<project-id>.env and update the values.

PROJECT_ID="example"
GH_REPO="your-org/your-repo"

# Local cached checkout managed by autodev.
PROJECT_REPO_DIR="projects/example/repo"

# Per-project runtime state written by autodev.
PROJECT_STATE_DIR="state/projects/example"

# Remote base branch and the long-lived autodev work branch.
BASE_BRANCH="main"
WORK_BRANCH="develop"

# Sync the cached checkout from GitHub at most once per interval.
SYNC_INTERVAL_SECS=14400

# Product planning only replenishes issues when the open pool drops to this size.
ISSUE_BUFFER_MIN=3

# Runtime limits per scheduled run.
MAX_TASKS=1
MAX_REVIEWS_PER_RUN=2

# Documentation-only hint for cron scheduling.
DEFAULT_RUN_INTERVAL_HOURS=2
